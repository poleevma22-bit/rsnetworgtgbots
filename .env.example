# rsnetworgtgbots service env (TEMPLATE — copy to .env, fill in real values)

# HTTP
PORT=4173
PUBLIC_BASE_URL=https://tg.example.com

# Sessions
SESSION_SECRET=replace-with-32+random-bytes-hex

# Telegram Bot API
TG_BOT_TOKEN=
TG_WEBHOOK_SECRET=

# Telegram MTProto (https://my.telegram.org)
TG_API_ID=
TG_API_HASH=

# AI providers (optional)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
